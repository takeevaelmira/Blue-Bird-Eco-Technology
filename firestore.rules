rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/favorites/{carId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['id', 'title', 'image', 'year', 'price', 'updatedAt'])
        && request.resource.data.id == carId;
    }
    
    // Правила для отзывов к автомобилям
    match /cars/{carId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'userPhoto', 'rating', 'text', 'createdAt']);
    }
  }
}
